/* To learn more about this file see: https://angular.dev/reference/configs/workspace-config. */
{
    "extends": "./tsconfig.lib.json",
    "compilerOptions": {
        "outDir": "../../out-tsc/spec",
        "types": [
            "jasmine",
            "node"
        ],
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": [
        "**/*.spec.ts",
        "**/*.d.ts"
    ],
    "exclude": []
}
