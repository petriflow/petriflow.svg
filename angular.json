{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "petriflow-svg": {
            "projectType": "library",
            "root": "projects/petriflow-svg",
            "sourceRoot": "projects/petriflow-svg/src",
            "prefix": "petriflow-svg",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "options": {
                        "tsConfig": "projects/petriflow-svg/tsconfig.lib.json",
                        "project": "projects/petriflow-svg/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/petriflow-svg/tsconfig.lib.prod.json"
                        }
                    }
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "tsConfig": "projects/petriflow-svg/tsconfig.spec.json",
                        "karmaConfig": "projects/petriflow-svg/karma.conf.js",
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ],
                        "sourceMap": true,
                        "codeCoverage": true,
                        "watch": false
                    }
                }
            }
        },
        "example-app": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "projects/example-app",
            "sourceRoot": "projects/example-app/src",
            "prefix": "pf-app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": {
                            "base": "dist/example-app",
                            "browser": ""
                        },
                        "index": "projects/example-app/src/index.html",
                        "browser": "projects/example-app/src/main.ts",
                        "polyfills": [
                            "zone.js"
                        ],
                        "tsConfig": "projects/example-app/tsconfig.app.json",
                        "assets": [
                            "projects/example-app/src/favicon.ico",
                            "projects/example-app/src/assets"
                        ],
                        "styles": [
                            "projects/example-app/src/styles.scss"
                        ],
                        "scripts": [],
                        "extractLicenses": false,
                        "sourceMap": true,
                        "optimization": false,
                        "namedChunks": true
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [
                                {
                                    "replace": "projects/example-app/src/environments/environment.ts",
                                    "with": "projects/example-app/src/environments/environment.prod.ts"
                                }
                            ],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "2mb",
                                    "maximumError": "6mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "100kb",
                                    "maximumError": "200kb"
                                }
                            ]
                        }
                    },
                    "defaultConfiguration": ""
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "options": {
                        "buildTarget": "example-app:build"
                    },
                    "configurations": {
                        "production": {
                            "buildTarget": "example-app:build:production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {
                        "buildTarget": "example-app:build"
                    }
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "polyfills": [
                            "zone.js",
                            "zone.js/testing"
                        ],
                        "tsConfig": "projects/example-app/tsconfig.spec.json",
                        "karmaConfig": "projects/example-app/karma.conf.js",
                        "assets": [
                            "projects/example-app/src/favicon.ico",
                            "projects/example-app/src/assets"
                        ],
                        "styles": [
                            "projects/example-app/src/styles.scss"
                        ],
                        "scripts": [],
                        "codeCoverage": true,
                        "watch": false
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false
    }
}
